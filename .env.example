# Google Drive Folders Configuration
GOOGLE_DRIVE_INPUT_FOLDER=https://drive.google.com/drive/folders/YOUR_INPUT_FOLDER_ID?usp=sharing
GOOGLE_DRIVE_OUTPUT_FOLDER=https://drive.google.com/drive/folders/YOUR_OUTPUT_FOLDER_ID?usp=sharing

# Automation Rules (Dynamic: supports 1 to 100+ items)
MIN_ITEMS_PER_DAY=1
REQUIRE_PHOTOS=false
MIN_PHOTOS_REQUIRED=0
AESTHETIC_PRESET=arif_cinematic
DEFAULT_LOCATION_NAME=Germany

# For Cloud Deployment: You can paste your token.json and client_secret.json contents as env vars if preferred
# GOOGLE_TOKEN_JSON={"token": "...", ...}
# GOOGLE_CLIENT_SECRET_JSON={"installed": "...", ...}
